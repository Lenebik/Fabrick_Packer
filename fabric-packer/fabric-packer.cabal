cabal-version:       2.2

name:                fabric-packer
version:             0.1.0.0
synopsis:            Optimal fabric layout calculator for sewing patterns
license:             BSD-3-Clause
license-file:        LICENSE
author:              Lebedevich Kirill
maintainer:          lebedevich.kirill@gmail.com
copyright:           2026 Lebedevich Kirill
category:            Application
build-type:          Simple
extra-source-files:  README.md

library
  hs-source-dirs:      src
  exposed-modules:
      Types
    , Log
    , Config
    , Parse.Image
    , Layout.NFP
    , Layout.Packing
    , Output
    , Render
    , Input.FileLoader
    , Input.CLI
  default-language:    Haskell2010
  build-depends:
      base          >= 4.7  && < 5
    , JuicyPixels   >= 3.3  && < 3.4
    , aeson         >= 2.0  && < 2.3
    , bytestring    >= 0.10 && < 0.13
    , time          >= 1.9  && < 1.15
    , directory     >= 1.3  && < 1.4
    , text          >= 1.2  && < 2.2
    , containers    >= 0.6  && < 0.8
  ghc-options:
      -Wall
      -Wcompat
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wno-missing-export-lists

executable fabric-packer
  hs-source-dirs:      app
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:
      base           >= 4.7 && < 5
    , fabric-packer
  ghc-options:
      -Wall
      -threaded
      -rtsopts
      -with-rtsopts=-N

executable test-parser
  hs-source-dirs:      test-parser
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:
      base           >= 4.7 && < 5
    , fabric-packer
  ghc-options:
      -Wall

executable test-pack
  hs-source-dirs:      test-pack
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:
      base           >= 4.7 && < 5
    , time
    , fabric-packer
  ghc-options:
      -Wall

executable test-qc
  hs-source-dirs:      test-qc
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:
      base           >= 4.7  && < 5
    , fabric-packer
    , aeson          >= 2.0  && < 2.3
    , bytestring     >= 0.10 && < 0.13
    , QuickCheck     >= 2.14 && < 2.16
  ghc-options:
      -Wall
      -threaded
      -rtsopts
      -with-rtsopts=-N

source-repository head
  type:     git
  location: https://github.com/klebedevich/fabric-packer
